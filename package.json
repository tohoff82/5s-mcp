{
  "name": "5s-mcp",
  "version": "1.0.1",
  "description": "5S Methodology MCP Server - Lean manufacturing principles for server management",
  "main": "src/mcp-server/index.js",
  "type": "module",
  "files": [
    "src",
    "config",
    "test",
    "scripts",
    "skills/5s-mcp",
    "docs/*.md",
    "docs/documentation-manifest.json",
    "docs/07-MAINTENANCE-LIFECYCLE",
    "docs/changes/5s-procedures/README.md",
    "docs/changes/5s-procedures/CHANGELOG-FORMAT.md",
    "docs/changes/5s-procedures/MONGODB-INTEGRATION.md",
    "docs/changes/5s-procedures/schemas",
    "docs/changes/5s-procedures/templates",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "TODO-LEAN-EXTENSIONS.md",
    "LICENSE",
    "demo.js",
    "install.sh",
    "mcp-config.json",
    "changelog.config.js",
    "create_todays_changelog.js"
  ],
  "scripts": {
    "start": "node src/mcp-server/index.js",
    "dev": "node --watch src/mcp-server/index.js",
    "test": "node --test",
    "check": "bash -n install.sh && node scripts/check-source.mjs",
    "docs:generate": "node scripts/generate-tools-reference.mjs",
    "docs:check": "node scripts/generate-tools-reference.mjs --check",
    "docs:links": "node scripts/verify-documentation-links.mjs",
    "docs:verify": "npm run docs:check && node scripts/verify-documentation.mjs",
    "poka:validate": "node scripts/validate-poka-yoke.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "pack:dry-run": "npm pack --dry-run",
    "verify": "npm run check && npm test && npm run docs:links && npm run docs:verify && npm run poka:validate && npm run audit:prod && npm run pack:dry-run",
    "safeops:test": "node --test test/safeops/*.test.js",
    "safeops:fixture:create": "node scripts/safeops-fixture.mjs create",
    "safeops:fixture:verify": "node scripts/safeops-fixture.mjs verify",
    "safeops:fixture:reset": "node scripts/safeops-fixture.mjs reset",
    "safeops:start": "node src/safeops/bootstrap.js"
  },
  "keywords": [
    "5S",
    "mcp",
    "model-context-protocol",
    "server-management",
    "lean",
    "kaizen",
    "seiri",
    "seiton",
    "seiso",
    "seiketsu",
    "shitsuke",
    "devops",
    "automation"
  ],
  "author": "tohoff82",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tohoff82/5s-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tohoff82/5s-mcp/issues"
  },
  "homepage": "https://github.com/tohoff82/5s-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
